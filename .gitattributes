# 行尾归一化 —— 这个仓库跨 Windows（开发）与 Linux（部署），必须显式声明。
#
# 背景：Windows 上 git 默认会把检出文件转成 CRLF，而 CRLF 会让
# Linux 上的 shell 脚本 shebang 变成 "#!/bin/bash^M" 直接报错。
# 本项目 deploy/setup.sh 是拷到服务器上 bash 执行的，必须强制 LF。

# 默认：入库统一 LF
* text=auto eol=lf

# Linux 侧执行/读取的文件 —— 强制 LF
*.sh      text eol=lf
*.conf    text eol=lf
*.service text eol=lf

# Windows 侧的文件 —— 强制 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制 —— 不做任何转换
*.webp     binary
*.png      binary
*.jpg      binary
*.apk      binary
*.keystore binary
*.idsig    binary
